# Optional: copy to .streamlit/secrets.toml (git-ignored).
# Without this file the dashboard uses Supabase if SUPABASE_* are set (env vars or .env),
# and otherwise the local Docker warehouse with its default credentials.

# Local Docker warehouse. Use port 5433 if POSTGRES_HOST_PORT=5433 in .env.
[connections.local]
dialect = "postgresql"
driver = "psycopg2"
host = "localhost"
port = 5432
database = "warehouse"
username = "postgres"
password = "postgres"

# Supabase: Project > Connect > Session pooler. When defined, the dashboard uses it
# (falling back to local if it's unreachable). For a public app, use a read-only role.
# [connections.supabase]
# dialect = "postgresql"
# driver = "psycopg2"
# host = "aws-0-<region>.pooler.supabase.com"
# port = 5432
# database = "postgres"
# username = "postgres.<project-ref>"
# password = "<password>"
# query = { sslmode = "require" }
