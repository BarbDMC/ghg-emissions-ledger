# Copy to .streamlit/secrets.toml (git-ignored) and adjust.
# Use port 5433 if POSTGRES_HOST_PORT=5433 in .env (local Homebrew Postgres on 5432).
[connections.postgresql]
dialect = "postgresql"
driver = "psycopg2"
host = "localhost"
port = 5432
database = "warehouse"
username = "postgres"
password = "postgres"
