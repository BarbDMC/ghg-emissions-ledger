# Copy this file to .env and fill in the values. Never commit .env.

# Climatiq API key (https://app.climatiq.io -> Project -> API keys)
CLIMATIQ_API_KEY=""

# Optional: pin a Climatiq data version (e.g. "^38"). Defaults to the latest release.
# CLIMATIQ_DATA_VERSION=""

# Optional: host port for the Docker Postgres (default 5432). Use 5433 if a local Postgres is running.
# POSTGRES_HOST_PORT=5433

# Active warehouse: local or supabase. The dashboard reads it (falling back to local if
# Supabase isn't usable), and the DAG loads it when triggered without choosing a target.
# After changing it, run `docker compose up -d` so Airflow picks it up.
WAREHOUSE_TARGET=local

# Supabase (cloud warehouse) for this project: Project > Connect > Session pooler.
# The direct db.<ref>.supabase.co host is IPv6-only, which Docker usually can't reach.
# Example host: aws-0-<region>.pooler.supabase.com; user: postgres.<project-ref>
SUPABASE_HOST=
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=
SUPABASE_PASSWORD=
SUPABASE_SSLMODE=require
